{
  "name": "shadi-saloon-customer-app",
  "version": "2.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "typecheck": "tsc -b --noEmit",
    "electron:dev": "electron desktop-main.js",
    "electron:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "express": "^4.18.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "description": "SHADI SALOON — standalone customer-facing app (booking wizard + branch showcase), built with React + Vite + TypeScript. Calls the main SHADI SALOON backend over the network; has no data of its own.",
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "build": {
    "appId": "com.shadisaloon.customerdesktop",
    "productName": "Shadi Saloon - Customer",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop-main.js",
      "server.js",
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop-main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "public/assets/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
