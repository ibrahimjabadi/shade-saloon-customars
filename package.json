  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
